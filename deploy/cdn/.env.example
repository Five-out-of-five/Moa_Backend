# docker compose 가 compose 파일 안의 ${...} 를 채울 때 읽는 값. 복사해서 deploy/cdn/.env 로 쓴다.
# 실제 값을 채운 .env 는 커밋하지 않는다.

# Redis 비밀번호. redis 컨테이너와 app 이 같이 쓴다. 만들기: openssl rand -hex 24
REDIS_PASSWORD=

# 다른 저장소 위치 (이 파일이 있는 deploy/cdn 기준). 서버에서 세 저장소를 나란히 받았으면 그대로 둔다.
#   ~/moa/Moa_Backend   ~/moa/Moa_Front   ~/moa/Moa_Python
FRONT_DIR=../../../Moa_Front
AI_DIR=../../../Moa_Python
