# Spring 백엔드 운영 환경변수. 복사해서 env/backend.env 로 쓰고 커밋하지 않는다.
# REDIS_HOST·REDIS_PORT·Redis 비밀번호·AI_SERVER_URL 은 compose 가 넣으므로 여기 적지 않는다.

# ===== 공개 주소 (CDN 도메인) =====
FRONTEND_URL=https://moarang.kro.kr
CORS_ALLOWED_ORIGINS=https://moarang.kro.kr
# HTTPS 에서만 쿠키가 실린다. 운영은 true.
COOKIE_SECURE=true
# 비워 두면 호스트 전용 쿠키. kro.kr 은 공개 접미사 목록에 없어 COOKIE_DOMAIN=kro.kr 은 절대 쓰면 안 된다.
COOKIE_DOMAIN=
WEBSOCKET_ENDPOINT=/ws

# ===== DB (RDS PostgreSQL 17, pgvector) =====
DB_URL=jdbc:postgresql://{RDS 엔드포인트}:5432/moa?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ===== Redis =====
REDIS_SSL_ENABLED=false

# ===== JWT (32바이트 이상, 필수) — openssl rand -base64 48 =====
JWT_SECRET_KEY=

# ===== 파일 (S3) =====
S3_BUCKET=
AWS_REGION=ap-northeast-2
# S3 를 쓰면 엔드포인트는 비운다(MinIO 용).
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
# 공개 이미지(public/*)를 CDN 으로 줄 때만 그 주소. 비우면 https://{버킷}.s3.{리전}.amazonaws.com 으로 만든다.
S3_CDN_URL=
# 비우면 EC2 IAM 역할을 쓴다(권장, IMDS 홉 제한 2 필요). 액세스 키를 쓸 때만 채운다.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ===== 소셜 로그인 =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# CDN 뒤에서는 서버가 자기 공개 주소를 알 수 없으므로 콜백 주소를 직접 지정한다.
# 각 콘솔에도 같은 주소를 등록한다.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_REDIRECTURI=https://moarang.kro.kr/login/oauth2/code/google
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_REDIRECTURI=https://moarang.kro.kr/login/oauth2/code/kakao
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_NAVER_REDIRECTURI=https://moarang.kro.kr/login/oauth2/code/naver

# ===== Python AI 서버 =====
# ai.env 의 INTERNAL_API_KEY 와 같은 값.
AI_INTERNAL_API_KEY=
AI_COST_THRESHOLD=80

# ===== 외부 연동 =====
INTEGRATION_SECRET_KEY=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://moarang.kro.kr/api/v1/integrations/notion/callback
