# Python AI 서버 운영 환경변수. 복사해서 저장소 루트의 .python.env 로 쓰고 커밋하지 않는다.
# 전체 키 설명은 Moa_Python/README.md

APP_ENV=prod
LOG_LEVEL=INFO

# .backend.env 의 AI_INTERNAL_API_KEY 와 같은 값. prod 에서는 필수. 만들기: openssl rand -hex 24
INTERNAL_API_KEY=

# 쉼표로 여러 개 지정하면 한도에 걸린 키 다음 키로 넘어간다.
GEMINI_API_KEY=

# prod 에서는 켤 수 없다.
AI_STUB_MODE=false
