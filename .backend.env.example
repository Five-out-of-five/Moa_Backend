# Spring 백엔드 운영 환경변수. 복사해서 저장소 루트의 .backend.env 로 쓰고 커밋하지 않는다.
# REDIS_HOST·REDIS_PORT·AI_SERVER_URL 은 compose 가 넣으므로 여기 적지 않는다.

# ===== Redis 비밀번호 (필수) =====
# Spring 과 redis 컨테이너가 같이 읽는다. 만들기: openssl rand -hex 24
SPRING_DATA_REDIS_PASSWORD=

# ===== 다른 저장소 위치 (선택) =====
# 기본값은 저장소 루트 기준 ../Moa_Front, ../Moa_Python 이다.
# 세 저장소를 나란히 받았으면 적지 않는다. (compose 파일을 해석할 때 쓰는 값이라 여기 적어도 읽지 않는다.
# 바꾸려면 실행 전에 셸에서 export FRONT_DIR=... AI_DIR=... 로 지정한다)

# ===== 공개 주소 (CDN 도메인) =====
FRONTEND_URL=https://moayo.site
CORS_ALLOWED_ORIGINS=https://moayo.site
# HTTPS 에서만 쿠키가 실린다. 운영은 true.
COOKIE_SECURE=true
# 비워 두면 호스트 전용 쿠키(권장). 프론트·백엔드가 같은 주소(CloudFront)라 도메인을 지정할 필요가 없다.
COOKIE_DOMAIN=
WEBSOCKET_ENDPOINT=/ws

# ===== DB (RDS PostgreSQL 17, pgvector) =====
DB_URL=jdbc:postgresql://{RDS 엔드포인트}:5432/moa?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ===== Redis =====
REDIS_SSL_ENABLED=false

# ===== JWT (32바이트 이상, 필수) — openssl rand -base64 48 =====
JWT_SECRET_KEY=

# ===== 파일 (S3) =====
S3_BUCKET=
AWS_REGION=ap-northeast-2
# S3 를 쓰면 엔드포인트는 비운다(MinIO 용).
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
# 공개 이미지(public/*)를 CDN 으로 줄 때만 그 주소. 비우면 https://{버킷}.s3.{리전}.amazonaws.com 으로 만든다.
S3_CDN_URL=
# 비우면 EC2 IAM 역할을 쓴다(권장, IMDS 홉 제한 2 필요). 액세스 키를 쓸 때만 채운다.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ===== 소셜 로그인 =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# CDN 뒤에서는 서버가 자기 공개 주소를 알 수 없으므로 콜백 주소를 직접 지정한다.
# 각 콘솔에도 같은 주소를 등록한다.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_REDIRECTURI=https://moayo.site/login/oauth2/code/google
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_REDIRECTURI=https://moayo.site/login/oauth2/code/kakao
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_NAVER_REDIRECTURI=https://moayo.site/login/oauth2/code/naver

# ===== Python AI 서버 =====
# .python.env 의 INTERNAL_API_KEY 와 같은 값.
AI_INTERNAL_API_KEY=
AI_COST_THRESHOLD=80

# ===== 외부 연동 =====
INTEGRATION_SECRET_KEY=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://moayo.site/api/v1/integrations/notion/callback
