# 로컬·운영에서 주입하는 환경변수 목록. 값을 채운 .env 는 커밋하지 않는다.
# local 프로파일이면 비워 둔 항목은 application-local.yaml 의 개발 기본값을 쓴다.

# Database
DB_URL=jdbc:postgresql://localhost:5432/moa
DB_USERNAME=moa
DB_PASSWORD=moa

# Redis (docker compose 로 함께 뜬다)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SSL_ENABLED=false

# JWT (32바이트 이상, 필수) — openssl rand -base64 48
JWT_SECRET_KEY=
COOKIE_DOMAIN=
COOKIE_SECURE=false

# CORS / WebSocket / 프론트엔드
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEBSOCKET_ENDPOINT=/ws
FRONTEND_URL=http://localhost:3000

# 스토리지: MinIO (AWS 로 바꿀 때는 docs/local-setup.md)
S3_BUCKET=moa-local
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_CDN_URL=
AWS_ACCESS_KEY=minioadmin
AWS_SECRET_KEY=minioadmin
AWS_REGION=ap-northeast-2

# 소셜 로그인. 비워 두면 기동에 실패한다. 실제 로그인을 쓸 때만 발급받은 값으로 바꾼다.
GOOGLE_CLIENT_ID=local-placeholder
GOOGLE_CLIENT_SECRET=local-placeholder
KAKAO_CLIENT_ID=local-placeholder
KAKAO_CLIENT_SECRET=local-placeholder
NAVER_CLIENT_ID=local-placeholder
NAVER_CLIENT_SECRET=local-placeholder

# Python AI 서버
AI_SERVER_URL=http://localhost:8000
# Python 서버 INTERNAL_API_KEY 와 같은 값. 비우면 헤더를 보내지 않는다(로컬).
AI_INTERNAL_API_KEY=
AI_COST_THRESHOLD=80

# 외부 연동
INTEGRATION_SECRET_KEY=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8080/api/v1/integrations/notion/callback
