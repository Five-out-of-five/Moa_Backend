# Next 프론트 운영 환경변수. 복사해서 저장소 루트의 .front.env 로 쓰고 커밋하지 않는다.
# 이 파일은 빌드 때(NEXT_PUBLIC_* 를 화면 코드에 박음)와 실행 때(서버 전용 값) 모두 쓴다.
# BACKEND_BASE_URL 은 compose 가 내부 주소(http://app:8080)로 넣으므로 여기 적지 않는다.

# 실서버 호출. true 면 목 데이터로 돈다.
NEXT_PUBLIC_USE_MOCK=false

# 브라우저가 연결하는 WebSocket 주소. CDN 도메인의 /ws 가 Spring 으로 간다.
NEXT_PUBLIC_WS_URL=wss://moayo.site/ws

API_DEFAULT_TIMEOUT_MS=10000
# 프론트가 심는 액세스 토큰 쿠키 이름. 백엔드 /ws 쿠키 인증과 같은 이름(accessToken)을 쓴다.
AUTH_ACCESS_TOKEN_COOKIE_NAME=accessToken
