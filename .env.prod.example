# 운영 서버용 환경변수. 서버에서 cp .env.prod.example .env.prod 후 값을 채운다. .env.prod 는 커밋하지 않는다.
# 비밀번호·키 생성 예: openssl rand -base64 48   (MinIO 비밀번호는 8자 이상, 특수문자 없이 쓰려면 openssl rand -hex 24)

# 공개 주소 (호스트 Nginx 가 HTTPS 로 받는 도메인)
PUBLIC_URL=https://moarang.kro.kr
# Docker Nginx 가 호스트에 여는 포트. 호스트 Nginx 가 127.0.0.1:이 포트로 넘긴다.
NGINX_PORT=8080

# PostgreSQL (Docker 내부망 전용)
POSTGRES_DB=moa
POSTGRES_USER=moa
POSTGRES_PASSWORD=

# Redis (Docker 내부망 전용)
REDIS_PASSWORD=

# MinIO (Docker 내부망 전용, 파일은 PUBLIC_URL/S3_BUCKET/ 경로로 공개된다)
MINIO_ROOT_USER=moa
MINIO_ROOT_PASSWORD=
# API 경로(/api, /ws, /oauth2, /login, /actuator 등)와 겹치지 않는 이름을 쓴다.
S3_BUCKET=moa-storage
S3_CDN_URL=
AWS_REGION=ap-northeast-2

# JWT (32바이트 이상, 필수)
JWT_SECRET_KEY=
# HTTPS 로만 서비스하므로 true. 프론트와 API 가 다른 하위 도메인이면 공통 상위 도메인을 넣는다.
COOKIE_DOMAIN=
COOKIE_SECURE=true

# 프론트엔드 주소 (쉼표로 여러 개). WebSocket 핸드셰이크 허용 오리진도 이 값을 쓴다.
CORS_ALLOWED_ORIGINS=https://moarang.kro.kr
FRONTEND_URL=https://moarang.kro.kr
WEBSOCKET_ENDPOINT=/ws

# 소셜 로그인. 각 콘솔의 리디렉션 URI 는 https://moarang.kro.kr/login/oauth2/code/{google|kakao|naver}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Python AI 서버. 같은 서버 호스트에서 돌리면 host.docker.internal 로 부른다. (0.0.0.0 에 바인딩해야 컨테이너에서 닿는다)
AI_SERVER_URL=http://host.docker.internal:8000
AI_COST_THRESHOLD=80

# 외부 연동
INTEGRATION_SECRET_KEY=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://moarang.kro.kr/api/v1/integrations/notion/callback
